{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoCapGate Studio",
  "version": "0.3.2",
  "identifier": "dev.mocapgate.studio",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoCapGate Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Video to motion capture (BVH/FBX) for Blender and Maya",
    "longDescription": "MoCapGate Studio turns a video of a person into a skeleton animation: MediaPipe on this computer or GVHMR on a GPU (Colab or your NVIDIA card), checks how well the video was caught, and exports BVH and FBX for Blender, Maya and game engines.",
    "copyright": "\u00a9 2026 CYBER Department. MIT licence.",
    "licenseFile": "../../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/package/": "mocapgate/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
